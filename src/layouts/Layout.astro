---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Taco Loco Cantina Mexicana | Authentic Mexican Food & Fiesta",
	description = "Taco Loco Cantina Mexicana — where bold Mexican street flavors, craft mezcal, and electric cantina energy collide. Hand-pressed tortillas, live music, and unforgettable vibes.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/images/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="taco loco, cantina mexicana, mexican restaurant, tacos, margaritas, mezcal, authentic mexican food, birria, street tacos" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/images/logo.png" />
		<meta name="theme-color" content="#1A1512" />
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bangers&family=Bebas+Neue&family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,400;1,700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* ===== TACO LOCO BRAND SYSTEM ===== */
	:root {
		/* Primary palette */
		--chili-red:     #D94F2B;
		--fire-orange:   #E8542E;
		--marigold:      #F2B705;
		--corn-yellow:   #F4C430;
		--avocado:       #5B7A4F;
		--fresh-green:   #3D8B4F;
		--espresso:      #1A1512;
		--dark-bg:       #0E0C09;
		--tortilla:      #FAF6EF;

		/* Derived tokens — light yellow theme */
		--bg-dark:       #FFF8DC;   /* cornsilk — page base */
		--bg-card:       #FFFAEC;   /* card surfaces */
		--bg-card-hover: #FFF4CC;   /* card hover */
		--bg-section:    #FFF3C4;   /* alternate section bg */

		--text-cream:    #2A1A05;   /* near-black for headings */
		--text-body:     #4A3515;   /* rich dark brown body */
		--text-muted:    #8C6D40;   /* muted warm brown */

		--gold-glow:     rgba(217, 79, 43, 0.25);
		--red-glow:      rgba(217, 79, 43, 0.35);
		--green-glow:    rgba(61, 139, 79, 0.25);

		--border-gold:   rgba(180, 120, 20, 0.3);
		--border-red:    rgba(217, 79, 43, 0.3);
		--border-subtle: rgba(140, 100, 40, 0.15);

		/* Typography */
		--font-display:  'Bangers', 'Impact', cursive;
		--font-heading:  'Bebas Neue', 'Arial Narrow', sans-serif;
		--font-sub:      'Playfair Display', Georgia, serif;
		--font-body:     'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;

		/* Spacing */
		--container-max: 1240px;
		--section-pad:   clamp(4rem, 8vw, 7rem);
	}

	/* ===== RESET & BASE ===== */
	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		font-size: 16px;
	}

	body {
		font-family: var(--font-body);
		background-color: var(--bg-dark);
		color: var(--text-body);
		min-height: 100vh;
		overflow-x: hidden;
		line-height: 1.65;
	}

	/* Custom scrollbar */
	::-webkit-scrollbar { width: 6px; }
	::-webkit-scrollbar-track { background: #F0E6C0; }
	::-webkit-scrollbar-thumb { background: var(--chili-red); border-radius: 3px; }
	::-webkit-scrollbar-thumb:hover { background: var(--marigold); }

	a { color: inherit; text-decoration: none; }
	button { font-family: inherit; cursor: pointer; border: none; outline: none; background: none; }
	img { display: block; max-width: 100%; height: auto; }

	/* ===== UTILITY CLASSES ===== */
	.font-display { font-family: var(--font-display); letter-spacing: 0.04em; }
	.font-heading  { font-family: var(--font-heading); letter-spacing: 0.08em; }
	.font-sub      { font-family: var(--font-sub); }

	.container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 2.5rem);
	}

	.gold-text {
		background: linear-gradient(135deg, #B85C0A 0%, #A04808 50%, #8B3A06 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	.red-text { color: var(--chili-red); }
	.cream-text { color: #1A0E04; }

	.section-tag {
		display: inline-block;
		font-family: var(--font-heading);
		font-size: 0.8rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--chili-red);
		margin-bottom: 0.75rem;
	}
	.section-tag.red { color: #B03020; }

	.divider {
		display: block;
		width: 60px;
		height: 3px;
		border-radius: 2px;
		background: linear-gradient(90deg, var(--chili-red), var(--marigold));
		margin: 1rem auto 0;
	}
	.divider.left { margin-left: 0; }

	/* ===== ANIMATIONS ===== */
	@keyframes fadeUp {
		from { opacity: 0; transform: translateY(40px); }
		to   { opacity: 1; transform: translateY(0); }
	}
	@keyframes floatY {
		0%, 100% { transform: translateY(0); }
		50%       { transform: translateY(-12px); }
	}
	@keyframes pulse-glow {
		0%, 100% { box-shadow: 0 0 20px var(--gold-glow); }
		50%       { box-shadow: 0 0 40px var(--gold-glow), 0 0 80px rgba(242,183,5,0.15); }
	}
	@keyframes marquee {
		from { transform: translateX(0); }
		to   { transform: translateX(-50%); }
	}
	@keyframes spin-slow {
		from { transform: rotate(0deg); }
		to   { transform: rotate(360deg); }
	}
	@keyframes scale-in {
		from { opacity: 0; transform: scale(0.92); }
		to   { opacity: 1; transform: scale(1); }
	}
	@keyframes shimmer-line {
		0%   { transform: translateX(-100%) skewX(-20deg); }
		100% { transform: translateX(200%) skewX(-20deg); }
	}

	/* Scroll reveal */
	.reveal {
		opacity: 0;
		transform: translateY(32px);
		transition: opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.75s cubic-bezier(0.22,1,0.36,1);
	}
	.reveal.visible { opacity: 1; transform: translateY(0); }

	.reveal-left {
		opacity: 0;
		transform: translateX(-36px);
		transition: opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.75s cubic-bezier(0.22,1,0.36,1);
	}
	.reveal-left.visible { opacity: 1; transform: translateX(0); }

	.reveal-right {
		opacity: 0;
		transform: translateX(36px);
		transition: opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.75s cubic-bezier(0.22,1,0.36,1);
	}
	.reveal-right.visible { opacity: 1; transform: translateX(0); }

	/* Stagger delays */
	.d1 { transition-delay: 0.05s; }
	.d2 { transition-delay: 0.15s; }
	.d3 { transition-delay: 0.25s; }
	.d4 { transition-delay: 0.35s; }
	.d5 { transition-delay: 0.45s; }
	.d6 { transition-delay: 0.55s; }
</style>
