---
// Layout.astro — Master Layout for Taco Loco Cantina Mexicana
// Performance: Google Fonts preconnect, GSAP loaded lazily via animations.js
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingTacoOrder from '../components/FloatingTacoOrder.astro';
import ReservationModal from '../components/ReservationModal.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  canonicalUrl?: string;
}

const {
  title = 'Mexikanisches Restaurant Berlin-Mitte | Taco Loco Cantina Mexicana',
  description = 'Tacos, Burritos, Quesadillas, Enchiladas, Fajitas & Cocktails mitten in Berlin-Mitte. Entdecke Taco Loco Cantina Mexicana in der Reinhardtstraße 37, 10117 Berlin.',
  activePage = 'home',
  canonicalUrl = Astro.url.href
} = Astro.props;

// Schema.org Restaurant Structured Data
const restaurantSchema = {
  "@context": "https://schema.org",
  "@type": ["Restaurant", "FoodEstablishment", "LocalBusiness"],
  "name": "Taco Loco Cantina Mexicana",
  "image": "https://tacoloco-berlin.de/logo.png",
  "url": "https://tacoloco-berlin.de",
  "telephone": "+49 30 12345678",
  "priceRange": "€€",
  "servesCuisine": ["Mexican", "Tex-Mex", "Tacos", "Burritos", "Quesadillas", "Cocktails"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Reinhardtstraße 37",
    "addressLocality": "Berlin",
    "addressRegion": "Berlin-Mitte",
    "postalCode": "10117",
    "addressCountry": "DE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 52.5206927,
    "longitude": 13.3797686
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
      "opens": "11:30",
      "closes": "23:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Friday", "Saturday"],
      "opens": "11:30",
      "closes": "00:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Sunday"],
      "opens": "12:00",
      "closes": "23:30"
    }
  ],
  "menu": "https://tacoloco-berlin.de/speisekarte",
  "acceptsReservations": "True"
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Performance: DNS prefetch + preconnect for Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- SEO Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#075319" />

    <!-- OpenGraph -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/logo.png" />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />
  </head>
  <body>
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="skip-to-content">Zum Inhalt springen</a>

    <!-- Scroll sentinel — IntersectionObserver target for sticky nav -->
    <!-- Sits right after nav, before hero, so when hero scrolls out of view nav activates -->
    <div id="navSentinel" aria-hidden="true" style="position:absolute;top:80px;left:0;width:1px;height:1px;pointer-events:none;"></div>

    <!-- Sticky Navigation Bar -->
    <Navbar activePage={activePage} />

    <!-- Main Page Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Persistent Floating Taco CTA -->
    <FloatingTacoOrder />

    <!-- Table Reservation Modal Dialog -->
    <ReservationModal />

    <!-- 
      Shared animation module — loaded AFTER page content (non-blocking).
      Manages: IntersectionObserver reveals, lazy GSAP, modal, drawer.
      Loading strategy: defer keeps it after DOM parse; does NOT block render.
    -->
    <script src="/scripts/animations.js" defer></script>

    <style>
      .skip-to-content {
        position: absolute;
        top: -100px;
        left: 1rem;
        background-color: var(--energy-red);
        color: var(--bg-canvas);
        padding: 0.75rem 1.2rem;
        border-radius: 8px;
        font-weight: 800;
        z-index: 9999;
        transition: top 0.2s ease;
      }

      .skip-to-content:focus {
        top: 1rem;
      }
    </style>
  </body>
</html>
