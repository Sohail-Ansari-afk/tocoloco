const items = [
  { nr: 10, name: 'Ensalada Mixta', price: '9,90 €', badge: 'VEGGIE 🌱', dietary: 'Vegetarisch', desc: 'Gemischter Salat mit hausgemachtem Dressing, Schafskäse, Croutons und Kaktusstreifen in Tortillaschale.' },
  { nr: 11, name: 'Caesar Chicken Salat', price: '11,90 €', badge: 'BELIEBT', desc: 'Gemischter Salat mit gegrillten Hähnchenbruststreifen, Caesar-Dressing, Parmesan und Croutons, mit 2 Tortillas.' },
  { nr: 12, name: 'Avocado Chicken Salat', price: '12,90 €', badge: '★ EMPFEHLUNG', desc: 'Gegrillte Hähnchenbruststreifen auf frischer Avocado mit Tomaten, Gurken, Paprika, roten Zwiebeln und Zitronensaft in Tortillaschale.' },
  { nr: 13, name: 'Ensalada Ranchero', price: '14,90 €', badge: 'STEAK SALAD', desc: 'Gegrillte argentinische Rindersteakstreifen mit Eisbergsalat, Tomaten, Gurken, Paprika, Oliven, Kaktusstreifen und Chef-Sauce, mit 2 Tortillas.' },
  { nr: 14, name: 'Ensalada Camarones', price: '14,90 €', badge: 'SEAFOOD 🦐', desc: 'Gegrillte bangladeschische Garnelen mit diversen Blattsalaten, Tomaten, Gurken, Paprika, Oliven und exotischem Obst, mit 2 Tortillas.' },
];
---

<Layout
  title="Frische Salate | Taco Loco Cantina Berlin-Mitte"
  description="Knackig frische Cantina-Salate in der Tortillaschale mit Avocado, Hähnchen, Steakstreifen oder Garnelen."
  activePage="speisekarte"
>
  <section class="dish-hero-section">
    <div class="cantina-container">
      <div class="dish-hero-grid">
        <div class="dish-hero-text">
          <span class="sticker-badge badge-favorite">🥗 FRISCHE SALATE</span>
          <h1 class="dish-page-h1">KNACKIG FRISCHE SALATE</h1>
          <p class="dish-hero-lead">
            Genieße bunte Salate in der knusprigen Tortillaschale mit frischer Avocado, saftigen Steakstreifen oder gegrillten Garnelen.
          </p>
          <div class="hero-action-row">
            <a href={GOOGLE_RESERVE_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
              <span>TISCH RESERVIEREN →</span>
            </a>
            <a href="/speisekarte" class="btn-secondary">
              <span>GANZE SPEISEKARTE</span>
            </a>
          </div>
        </div>
        <div class="dish-hero-image-wrap">
          <img src="/images/salad.webp" alt="Salate Taco Loco" class="dish-main-img" width="400" height="320" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="dish-showcase-section">
    <div class="cantina-container">
      <div class="taco-editorial-grid">
        {items.map((item) => (
          <article class="dish-spread-item">
            <div class="dish-item-header">
              <div class="dish-item-title-grp">
                <span class="dish-nr-badge">#{item.nr}</span>
                <h3 class="taco-name">{item.name}</h3>
                {item.badge && <span class="sticker-badge badge-new">{item.badge}</span>}
              </div>
              <span class="taco-price">{item.price}</span>
            </div>
            <p class="taco-desc">{item.desc}</p>
            <div class="dish-item-footer">
              <a href={GOOGLE_RESERVE_URL} target="_blank" rel="noopener noreferrer" class="reserve-link">
                <span>TISCH RESERVIEREN →</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .dish-hero-section { background-color: var(--bg-canvas); padding: 4.5rem 0 3.5rem; border-bottom: 3px solid var(--brand-green); }
  .dish-hero-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: center; }
  .dish-page-h1 { color: var(--brand-green); font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 0.6rem 0 0.8rem; }
  .dish-hero-lead { font-size: 1.15rem; color: var(--text-dark); line-height: 1.6; margin-bottom: 2rem; }
  .hero-action-row { display: flex; flex-wrap: wrap; gap: 1rem; }
  .dish-hero-image-wrap { display: flex; justify-content: center; }
  .dish-main-img { max-width: 100%; height: auto; filter: drop-shadow(0 14px 28px rgba(7,83,25,0.25)); }
  .dish-showcase-section { background-color: var(--bg-canvas); padding: 4.5rem 0 6rem; }
  .taco-editorial-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 3rem; }
  .dish-spread-item { border-bottom: var(--border-dashed); padding-bottom: 1.4rem; display: flex; flex-direction: column; }
  .dish-item-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.5rem; }
  .dish-item-title-grp { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .dish-nr-badge { font-size: 0.82rem; font-weight: 900; color: #FFFDF3; background-color: var(--brand-green); padding: 0.15rem 0.45rem; border-radius: 6px; }
  .taco-name { font-size: 1.22rem; color: var(--brand-green); margin: 0; }
  .taco-price { font-family: var(--font-display); font-size: 1.35rem; font-weight: 900; color: var(--energy-red); white-space: nowrap; }
  .taco-desc { font-size: 0.96rem; line-height: 1.5; color: var(--text-ink); margin: 0 0 0.8rem; }
  .dish-item-footer { margin-top: auto; }
  .reserve-link { font-family: var(--font-body); font-weight: 900; font-size: 0.82rem; color: var(--energy-red); text-transform: uppercase; text-decoration: none; }
  .reserve-link:hover { color: var(--brand-green); }
  @media (max-width: 900px) { .dish-hero-grid, .taco-editorial-grid { grid-template-columns: 1fr; } }
</style>
