	transition: color 0.25s ease;
}
.nav-link::after {
	content: '';
	position: absolute;
	bottom: 4px; left: 50%;
	transform: translateX(-50%);
	width: 0; height: 2px;
	background: var(--chili-red);
	border-radius: 1px;
	transition: width 0.3s ease;
}
.nav-link:hover { color: var(--chili-red); }
