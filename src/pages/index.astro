---
import Layout from '../layouts/Layout.astro';

const menuCategories = [
	{ id: 'all', label: 'Todo', emoji: '🌮' },
	{ id: 'tacos', label: 'Tacos Locos', emoji: '🌮' },
	{ id: 'mains', label: 'Platos Fuertes', emoji: '🔥' },
	{ id: 'antojitos', label: 'Antojitos', emoji: '🥑' },
	{ id: 'drinks', label: 'Margaritas & Bebidas', emoji: '🥃' }
];

const menuItems = [
	{
		id: '1',
		name: 'Birria QuesaTacos',
		category: 'tacos',
		price: '$18.50',
		tag: 'Loco Favorite',
		tagColor: 'red',
		description: 'Three crispy corn tortillas filled with slow-cooked beef birria, melted Oaxaca cheese, onions, cilantro, and a rich consommé for dipping.',
		image: '/images/90a6f1e5-5926-441e-ac9e-c9f1f27e2d87.avif'
	},
	{
		id: '2',
		name: 'Wagyu Carne Asada',
		category: 'mains',
		price: '$38.00',
		tag: 'Chef Signature',
		tagColor: 'gold',
		description: 'Charcoal-grilled premium Wagyu skirt steak, served with charred spring onions, chimichurri, and scratch-made warm corn tortillas.',
		image: '/images/7142efe2-b902-4f22-b6f4-c493a7b7a5f5.avif'
	},
	{
		id: '3',
		name: 'Charred Pulpo al Pastor',
		category: 'mains',
		price: '$32.00',
		tag: 'New',
		tagColor: 'green',
		description: 'Tender Pacific octopus marinated in achiote and grilled over mesquite wood, served with caramelized pineapple puree and pickled red onions.',
		image: '/images/c3fc67ac-6605-4482-ab8d-ab1b2db52c87.avif'
	},
	{
		id: '4',
		name: 'Duck Carnitas Tacos',
		category: 'tacos',
		price: '$19.50',
		tag: 'Premium',
		tagColor: 'gold',
		description: 'Crispy duck confit carnitas, pickled serrano pepper, fresh avocado salsa, and micro-greens on hand-pressed yellow corn tortillas.',
		image: '/images/3a7634ed-269f-4e0a-ab61-766e75c22622.avif'
	},
	{
		id: '5',
		name: 'Smoked Mezcal Paloma',
		category: 'drinks',
		price: '$15.00',
		tag: 'House Special',
		tagColor: 'blue',
		description: 'Artisanal Espadín Mezcal, fresh grapefruit juice, lime, agave syrup, topped with sparkling water and a volcanic chili-salt rim.',
		image: '/images/63aeb8d1-124b-4103-a215-a365428d191e.avif'
	},
	{
		id: '6',
		name: 'Street Corn Esquites',
		category: 'antojitos',
		price: '$9.50',
		tag: 'Classic',
		tagColor: 'gold',
		description: 'Sweet corn shaved off the cob, tossed in chipotle aioli, cotija cheese, fresh lime juice, and dusted with Tajín seasoning.',
		image: '/images/27da9583-52e3-486f-89ff-66d857e462fa.avif'
	},
	{
		id: '7',
		name: 'Smoked Guacamole & Totopos',
		category: 'antojitos',
		price: '$12.00',
		tag: 'Fresh',
		tagColor: 'green',
		description: 'Hass avocados mashed with lime, sea salt, onions, cilantro, and tomatoes, infused with mesquite wood smoke under a glass dome.',
		image: '/images/f6b93f58-8ae1-4f40-8ad8-c5cf52dc782d.avif'
	},
	{
		id: '8',
		name: 'Oaxacan Old Fashioned',
		category: 'drinks',
		price: '$16.50',
		tag: 'Reserve',
		tagColor: 'gold',
		description: 'Añejo Tequila, Mezcal, agave nectar, and chocolate mole bitters, stirred and served over a single clear ice block.',
		image: '/images/05720a3d-d378-4dbd-bae0-cd98fdb303a5.avif'
	},
	{
		id: '9',
		name: 'Tres Leches Churro Tower',
		category: 'antojitos',
		price: '$11.00',
		tag: 'Sweet',
		tagColor: 'red',
		description: 'Warm house-made churros dusted in cinnamon sugar, stacked over a pool of traditional sweet tres leches milk reduction.',
		image: '/images/12c79289-edec-4cf1-b1c8-28d974ae2752.avif'
	}
];

const galleryImages = [
	{ src: '/images/7142efe2-b902-4f22-b6f4-c493a7b7a5f5.avif', label: 'Wagyu off the Mesquite Grill', span: 'wide' },
	{ src: '/images/c3fc67ac-6605-4482-ab8d-ab1b2db52c87.avif', label: 'Pulpo al Pastor', span: '' },
	{ src: '/images/27da9583-52e3-486f-89ff-66d857e462fa.avif', label: 'Esquites Clasicos', span: '' },
	{ src: '/images/3a7634ed-269f-4e0a-ab61-766e75c22622.avif', label: 'Duck Carnitas Perfection', span: '' },
	{ src: '/images/12c79289-edec-4cf1-b1c8-28d974ae2752.avif', label: 'Tres Leches Churros', span: 'wide' },
	{ src: '/images/63aeb8d1-124b-4103-a215-a365428d191e.avif', label: 'Craft Mezcal Paloma', span: '' },
];

const vibeFeatures = [
	{ icon: '🥂', title: 'Happy Hour Loca', desc: '2-for-1 Margaritas & Half-price Tacos every Tue–Thu, 4–6 PM.' },
	{ icon: '🎸', title: 'Live Mariachi & Latin Soul', desc: 'Authentic live acoustic performances every Thursday, Friday & Saturday night.' },
	{ icon: '🥑', title: 'Guacamole Masterclass', desc: 'Join Chef Mateo every Saturday morning to learn the secrets of perfect Oaxacan salsas.' },
	{ icon: '🌶️', title: 'Salsa Tasting Board', desc: 'Seven house-made salsas from mild to mouth-scorching — find your fire level.' },
];

const stats = [
	{ num: '100%', label: 'Scratch Cooked' },
	{ num: '48H', label: 'Birria Marinade' },
	{ num: '0', label: 'Artificial Additives' },
	{ num: '50+', label: 'Artisanal Mezcals' },
];

const marqueeItems = ['Birria QuesaTacos', '•', 'Wagyu Asada', '•', 'Mezcal Paloma', '•', 'Street Corn', '•', 'Duck Carnitas', '•', 'Smoked Guac', '•', 'Churro Tower', '•', 'Oaxacan Old Fashioned', '•'];
---

<Layout title="Taco Loco Cantina Mexicana | Bold Flavors, Bigger Vibes">

<!-- ===================== NAVBAR ===================== -->
<header class="navbar" id="navbar">
	<div class="nav-container">
		<a href="#" class="nav-logo" aria-label="Taco Loco Home">
			<img src="/images/logo.png" alt="Taco Loco Cantina Mexicana" class="logo-img" />
		</a>

		<nav class="nav-links" id="navLinks" aria-label="Primary navigation">
			<a href="#about" class="nav-link">Our Story</a>
			<a href="#menu" class="nav-link">El Menú</a>
			<a href="#vibe" class="nav-link">The Vibe</a>
			<a href="#gallery" class="nav-link">Gallery</a>
			<a href="#reserve" class="nav-link">Reservations</a>
		</nav>

		<div class="nav-right">
			<a href="#reserve" class="btn-cta">Book a Table</a>
			<button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
				<span></span><span></span><span></span>
			</button>
		</div>
	</div>
</header>

<!-- Mobile nav drawer -->
<div class="mobile-nav" id="mobileNav" aria-hidden="true">
	<a href="#about" class="mobile-link">Our Story</a>
	<a href="#menu" class="mobile-link">El Menú</a>
	<a href="#vibe" class="mobile-link">The Vibe</a>
	<a href="#gallery" class="mobile-link">Gallery</a>
	<a href="#reserve" class="mobile-link">Reservations</a>
	<a href="#reserve" class="btn-cta mobile-cta">Book a Table</a>
</div>

<!-- ===================== HERO ===================== -->
<section class="hero" id="hero">
	<div class="hero-bg">
		<div class="hero-gradient"></div>
		<div class="hero-orb orb-1"></div>
		<div class="hero-orb orb-2"></div>
		<div class="hero-orb orb-3"></div>
		<div class="hero-orb orb-4"></div>
		<div class="hero-overlay"></div>
	</div>

	<div class="hero-content">
		<div class="hero-badge font-heading">
			<span>🔥</span> Sizzling Live on the Mesquite Grill
		</div>

		<h1 class="hero-headline font-display">
			Crave the Crazy,<br/>
			<span class="hero-bright-yellow">Love the Loco!</span>
		</h1>

		<p class="hero-sub">
			Welcome to the ultimate fiesta of flavor. Bold street tacos, craft mezcal cocktails, and electric Mexican cantina energy — right in the heart of town.
		</p>

		<div class="hero-ctas">
			<a href="#menu" class="btn-hero-primary">Explore El Menú</a>
			<a href="#reserve" class="btn-hero-secondary">Book a Fiesta</a>
		</div>

		<div class="hero-pills">
			<span class="pill">🌮 Nixtamal Masa Tortillas</span>
			<span class="pill">🍋 Freshly Squeezed Limes</span>
			<span class="pill">🥃 50+ Artisanal Mezcals</span>
		</div>
	</div>

	<div class="hero-wave">
		<svg viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M0 40 C240 90, 480 10, 720 55 C960 100, 1200 20, 1440 50 L1440 100 L0 100 Z" fill="#100E0B"/>
		</svg>
	</div>
</section>

<!-- ===================== MARQUEE TICKER ===================== -->
<div class="marquee-bar">
	<div class="marquee-track">
		{[...marqueeItems, ...marqueeItems].map(item => (
			<span class="marquee-item font-heading">{item}</span>
		))}
	</div>
</div>

<!-- ===================== ABOUT / STORY ===================== -->
<section class="about-section" id="about">
	<div class="container">
		<div class="about-grid">
			<div class="about-images reveal-left">
				<div class="about-img-main">
					<img src="/images/90a6f1e5-5926-441e-ac9e-c9f1f27e2d87.avif" alt="Birria QuesaTacos — the Loco Favorite" />
					<div class="img-chip font-heading">BIRRIA TACOS</div>
				</div>
				<div class="about-img-sub">
					<img src="/images/f6b93f58-8ae1-4f40-8ad8-c5cf52dc782d.avif" alt="Smoked Guacamole & Totopos" />
					<div class="img-chip font-heading">SMOKED GUAC</div>
				</div>
				<div class="about-float-badge font-display">
					<span class="badge-num">2024</span>
					<span class="badge-label">Est.</span>
				</div>
			</div>

			<div class="about-content">
				<span class="section-tag">BIENVENIDOS</span>
				<h2 class="about-title font-display reveal d1">The Story of<br/><span class="gold-text">Taco Loco</span></h2>
				<span class="divider left reveal d2"></span>

				<p class="about-para reveal d3">
					Taco Loco was born from a single obsession: to bring the electric energy, vibrant aromas, and smoky firepower of Mexico City's legendary street markets straight to your table. We don't do boring — not ever.
				</p>
				<p class="about-para reveal d4">
					Our tortillas are hand-pressed daily from non-GMO heirloom blue and yellow corn nixtamal masa. Our grill master keeps the mesquite coals white-hot. Our mixologist curates the town's finest selection of small-batch mezcals and organic tequilas — because every sip should feel like a story.
				</p>

				<blockquote class="about-quote font-sub reveal d5">
					"At Taco Loco, every taco is a tiny festival of taste."
				</blockquote>

				<div class="about-stats reveal d6">
					{stats.map(s => (
						<div class="stat-item">
							<span class="stat-num font-display gold-text">{s.num}</span>
							<span class="stat-label">{s.label}</span>
						</div>
					))}
				</div>

				<div class="about-ctas reveal d6">
					<a href="#menu" class="btn-primary">Discover the Menú</a>
					<a href="#vibe" class="btn-outline">The Cantina Vibe</a>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- ===================== MENU ===================== -->
<section class="menu-section" id="menu">
	<div class="menu-bg-texture"></div>
	<div class="container">
		<div class="section-header reveal">
			<span class="section-tag red">EL MENÚ</span>
			<h2 class="section-title font-display">Bold Colors,<br/><span class="gold-text">Bolder Flavors</span></h2>
			<span class="divider"></span>
			<p class="section-desc">
				Every dish is crafted from scratch — no shortcuts, no freezer shortcuts. Gluten-free tortillas available on request.
			</p>
		</div>

		<!-- Filter tabs -->
		<div class="menu-tabs" role="tablist">
			{menuCategories.map((cat, idx) => (
				<button
					class={`tab-btn font-heading${idx === 0 ? ' active' : ''}`}
					data-cat={cat.id}
					role="tab"
					aria-selected={idx === 0 ? 'true' : 'false'}
				>
					{cat.emoji} {cat.label}
				</button>
			))}
		</div>

		<!-- Menu grid -->
		<div class="menu-grid" id="menuGrid">
			{menuItems.map(item => (
				<article class="menu-card reveal" data-category={item.category}>
					<div class="card-img-wrap">
						<img src={item.image} alt={item.name} loading="lazy" />
						{item.tag && (
							<span class={`card-badge font-heading badge-${item.tagColor}`}>{item.tag}</span>
						)}
						<div class="card-img-shine"></div>
					</div>
					<div class="card-body">
						<div class="card-top">
							<h3 class="card-name font-display">{item.name}</h3>
							<span class="card-price font-heading gold-text">{item.price}</span>
						</div>
						<p class="card-desc">{item.description}</p>
						<button class="card-order-btn font-heading" data-item={item.name} aria-label={`Order ${item.name}`}>
							Order Now →
						</button>
					</div>
				</article>
			))}
		</div>

		<div class="menu-cta-row reveal">
			<a href="#reserve" class="btn-primary">Book Your Table</a>
		</div>
	</div>
</section>

<!-- ===================== VIBE SECTION ===================== -->
<section class="vibe-section" id="vibe">
	<div class="container">
		<div class="vibe-grid">
			<div class="vibe-media reveal-left">
				<div class="vibe-img-frame">
					<img src="/images/63aeb8d1-124b-4103-a215-a365428d191e.avif" alt="Smoked Mezcal Paloma — craft cocktail at Taco Loco" />
					<div class="vibe-img-badge font-heading">
						LIVE MUSIC<br/>THU — SAT
					</div>
				</div>
				<div class="vibe-img-small">
					<img src="/images/05720a3d-d378-4dbd-bae0-cd98fdb303a5.avif" alt="Oaxacan Old Fashioned — Reserve cocktail" />
				</div>
			</div>

			<div class="vibe-content">
				<span class="section-tag">CANTINA EXPERIENCE</span>
				<h2 class="section-title font-display reveal d1">Tequila, Mezcal<br/><span class="gold-text">&amp; Good Vibes</span></h2>
				<span class="divider left reveal d2"></span>
				<p class="vibe-intro reveal d3">
					A true cantina is more than a restaurant — it's a community, a sensory overload, and a sanctuary of celebration. Settle in, let the Latin rhythms take over, and leave your worries at the door.
				</p>

				<ul class="vibe-list">
					{vibeFeatures.map((f, i) => (
						<li class={`vibe-item reveal d${i + 2}`}>
							<span class="vibe-icon">{f.icon}</span>
							<div>
								<strong class="vibe-item-title font-heading">{f.title}</strong>
								<p>{f.desc}</p>
							</div>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>
</section>

<!-- ===================== GALLERY ===================== -->
<section class="gallery-section" id="gallery">
	<div class="container">
		<div class="section-header reveal">
			<span class="section-tag">SNAP THE LOCO VIBE</span>
			<h2 class="section-title font-display">Instagrammable<br/><span class="gold-text">Every. Single. Dish.</span></h2>
			<span class="divider"></span>
		</div>

		<div class="gallery-grid">
			{galleryImages.map((img, i) => (
				<div class={`gallery-item${img.span === 'wide' ? ' wide' : ''} reveal d${(i % 3) + 1}`}>
					<img src={img.src} alt={img.label} loading="lazy" />
					<div class="gallery-overlay">
						<span class="gallery-label font-heading">{img.label}</span>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<!-- ===================== RESERVATIONS ===================== -->
<section class="reserve-section" id="reserve">
	<div class="reserve-bg">
		<img src="/images/90a6f1e5-5926-441e-ac9e-c9f1f27e2d87.avif" alt="Reserve your spot" class="reserve-bg-img" />
		<div class="reserve-bg-overlay"></div>
	</div>

	<div class="container reserve-container">
		<div class="reserve-info reveal-left">
			<span class="section-tag">JOIN THE FIESTA</span>
			<h2 class="reserve-title font-display">Reserve<br/><span class="gold-text">Your Table</span></h2>
			<span class="divider left"></span>
			<p class="reserve-desc">
				Reservations are strongly recommended — especially for Thursday to Saturday dinner slots. Walk-ins are welcome at the bar and outdoor patio.
			</p>

			<div class="reserve-details">
				<div class="res-detail">
					<span class="res-icon">📞</span>
					<div>
						<strong>Call Us</strong>
						<p>+1 (555) 323-LOCO</p>
					</div>
				</div>
				<div class="res-detail">
					<span class="res-icon">📍</span>
					<div>
						<strong>Find Us</strong>
						<p>245 Marigold St, Downtown Cantina Quarter</p>
					</div>
				</div>
				<div class="res-detail">
					<span class="res-icon">✉️</span>
					<div>
						<strong>Email</strong>
						<p>hola@tacolocorestaurant.com</p>
					</div>
				</div>
			</div>

			<div class="hours-block">
				<h4 class="font-heading hours-title">Hours of Operation</h4>
				<div class="hours-row"><span>Mon — Thu</span><span>4:00 PM – 10:00 PM</span></div>
				<div class="hours-row"><span>Fri — Sat</span><span>12:00 PM – 12:00 AM</span></div>
				<div class="hours-row"><span>Sunday</span><span>12:00 PM – 9:00 PM</span></div>
			</div>
		</div>

		<div class="reserve-form-wrap reveal-right">
			<div class="reserve-form-card">
				<h3 class="form-title font-display">Secure Your Spot</h3>
				<span class="divider left"></span>

				<form class="booking-form" id="bookingForm" novalidate>
					<div class="form-row-2">
						<div class="form-field">
							<label for="bookName">Your Name</label>
							<input type="text" id="bookName" name="name" placeholder="e.g. Carlos Mendez" required />
						</div>
						<div class="form-field">
							<label for="bookPhone">Phone Number</label>
							<input type="tel" id="bookPhone" name="phone" placeholder="+1 (555) 123-4567" required />
						</div>
					</div>
					<div class="form-row-2">
						<div class="form-field">
							<label for="bookDate">Date</label>
							<input type="date" id="bookDate" name="date" required />
						</div>
						<div class="form-field">
							<label for="bookTime">Time Slot</label>
							<select id="bookTime" name="time" required>
								<option value="17:00">5:00 PM</option>
								<option value="18:00">6:00 PM</option>
								<option value="19:00" selected>7:00 PM</option>
								<option value="20:00">8:00 PM</option>
								<option value="21:00">9:00 PM</option>
							</select>
						</div>
					</div>
					<div class="form-row-2">
						<div class="form-field">
							<label for="bookGuests">Guests</label>
							<select id="bookGuests" name="guests" required>
								<option value="1">1 Person</option>
								<option value="2" selected>2 People</option>
								<option value="3">3 People</option>
								<option value="4">4 People</option>
								<option value="5">5 People</option>
								<option value="6">6 People</option>
								<option value="8">8+ (Group)</option>
							</select>
						</div>
						<div class="form-field">
							<label for="bookSeating">Seating Area</label>
							<select id="bookSeating" name="seating">
								<option value="indoor">Indoor Main Cantina</option>
								<option value="bar">Mezcal Bar Counter</option>
								<option value="patio">Outdoor Patio</option>
							</select>
						</div>
					</div>
					<div class="form-field">
						<label for="bookNotes">Special Notes (allergies, birthdays…)</label>
						<textarea id="bookNotes" name="notes" rows="3" placeholder="Tell us how to make your visit unforgettable!"></textarea>
					</div>
					<button type="submit" class="btn-submit font-heading" id="submitBtn">
						Confirm Reservation 🎉
					</button>
				</form>

				<div class="booking-success" id="bookingSuccess" style="display:none">
					<div class="success-icon">🎊</div>
					<h4 class="font-display">¡Fiesta Confirmed!</h4>
					<p>Your table is reserved. We'll send a confirmation to your phone. Get ready for a wild night!</p>
					<button class="btn-outline" id="resetBooking">Make Another Reservation</button>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- ===================== FOOTER ===================== -->
<footer class="footer">
	<div class="footer-glow"></div>
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<img src="/images/logo.png" alt="Taco Loco Cantina Mexicana" class="footer-logo" />
				<p class="footer-tagline">
					Spreading bold flavors, fresh street tacos, and top-tier agave cocktails since 2024. Life's too short for boring food.
				</p>
				<div class="social-row">
					<a href="#" class="social-btn" aria-label="Instagram">
