/* ===================== HERO ===================== */
.hero {
	position: relative;
	min-height: 100dvh;
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
	background: #0E0C09;
}
.hero-bg {
	position: absolute;
	inset: 0;
	z-index: 0;
	overflow: hidden;
}
.hero-gradient {
	position: absolute;
	inset: -50%;
	width: 200%;
	height: 200%;
	background: linear-gradient(
		-45deg,
		#0e0c09,
		#4a0e05,
		#d94f2b,
		#e8542e,
		#9e1b0c,
		#f2b705,
		#2e5c38,
		#1a1512
	);
	background-size: 400% 400%;
	animation: gradientFlow 16s ease infinite;
	filter: blur(20px);
}

@keyframes gradientFlow {
	0% { background-position: 0% 50%; }
	50% { background-position: 100% 50%; }
	100% { background-position: 0% 50%; }
}

.hero-orb {
	position: absolute;
	border-radius: 50%;
	filter: blur(75px);
	opacity: 0.75;
	pointer-events: none;
	will-change: transform;
}

.orb-1 {
	top: 10%;
	left: 10%;
	width: 450px;
	height: 450px;
	background: radial-gradient(circle, rgba(232, 84, 46, 0.85) 0%, rgba(217, 79, 43, 0) 70%);
	animation: floatOrb1 18s ease-in-out infinite alternate;
}

.orb-2 {
	bottom: 10%;
	right: 10%;
	width: 520px;
	height: 520px;
	background: radial-gradient(circle, rgba(242, 183, 5, 0.75) 0%, rgba(244, 196, 48, 0) 70%);
	animation: floatOrb2 22s ease-in-out infinite alternate;
}

.orb-3 {
	top: 35%;
	right: 25%;
	width: 400px;
	height: 400px;
	background: radial-gradient(circle, rgba(168, 30, 20, 0.8) 0%, rgba(138, 26, 12, 0) 70%);
	animation: floatOrb3 16s ease-in-out infinite alternate;
}

.orb-4 {
	bottom: 25%;
	left: 20%;
	width: 380px;
	height: 380px;
	background: radial-gradient(circle, rgba(61, 139, 79, 0.55) 0%, rgba(91, 122, 79, 0) 70%);
	animation: floatOrb4 20s ease-in-out infinite alternate;
}

@keyframes floatOrb1 {
	0% { transform: translate(0, 0) scale(1); }
	50% { transform: translate(120px, 80px) scale(1.2); }
	100% { transform: translate(-60px, 140px) scale(0.9); }
}

@keyframes floatOrb2 {
	0% { transform: translate(0, 0) scale(1); }
	50% { transform: translate(-140px, -100px) scale(1.15); }
	100% { transform: translate(80px, -150px) scale(0.85); }
}

@keyframes floatOrb3 {
	0% { transform: translate(0, 0) scale(1); }
	50% { transform: translate(-100px, 120px) scale(1.25); }
	100% { transform: translate(120px, -80px) scale(0.95); }
}

@keyframes floatOrb4 {
	0% { transform: translate(0, 0) scale(1); }
	50% { transform: translate(100px, -120px) scale(1.1); }
	100% { transform: translate(-100px, 60px) scale(1.3); }
}

