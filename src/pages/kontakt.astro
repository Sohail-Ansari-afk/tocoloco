---
// kontakt.astro — Zero-Cards Contact & Table Booking Page
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt & Reservierung | Taco Loco Cantina Berlin-Mitte"
  description="Kontaktiere Taco Loco Cantina Mexicana in Berlin-Mitte oder reserviere deinen Tisch online. Reinhardtstraße 37, 10117 Berlin."
  activePage="kontakt"
>
  <section class="kontakt-hero-section">
    <div class="cantina-container">
      <div class="kontakt-hero-grid">
        
        <!-- Info Column (NO BOX CARDS) -->
        <div class="kontakt-info-col">
          <span class="sticker-badge badge-favorite">📞 KONTAKT & RESERVIERUNG</span>
          <h1 class="kontakt-page-h1">WIR FREUEN UNS AUF DICH!</h1>
          <p class="kontakt-lead">
            Hast du Fragen zu unserer Speisekarte, möchtest eine Veranstaltung planen oder einen Tisch reservieren? Kontaktiere uns direkt oder nutze unser Online-Formular.
          </p>

          <div class="kontakt-direct-list">
            <div class="c-item">
              <span class="c-glyph">📍</span>
              <div>
                <strong>Adresse</strong>
                <p><a href="https://maps.app.goo.gl/L1YRicrkoW9naqQZ8" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline;">Reinhardtstraße 37, 10117 Berlin-Mitte</a></p>
              </div>
            </div>

            <div class="c-item">
              <span class="c-glyph">📞</span>
              <div>
                <strong>Telefon</strong>
                <p><a href="tel:+493094054782">+49 30 94054782</a></p>
              </div>
            </div>

            <div class="c-item">
              <span class="c-glyph">✉️</span>
              <div>
                <strong>E-Mail</strong>
                <p><a href="mailto:info@taco-loco-berlin.de">info@taco-loco-berlin.de</a></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Column (NO BOX CARDS - Pure Open Clean Form) -->
        <div class="kontakt-form-col">
          <h2 class="form-title">TISCH ONLINE RESERVIEREN</h2>

          <form id="contactPageForm" class="clean-cantina-form">
            <div class="form-row-2">
              <div class="field-grp">
                <label for="c_name">Vollständiger Name *</label>
                <input type="text" id="c_name" required placeholder="z. B. Carlos Müller" class="cantina-input" />
              </div>
              <div class="field-grp">
                <label for="c_phone">Telefonnummer *</label>
                <input type="tel" id="c_phone" required placeholder="+49 170 1234567" class="cantina-input" />
              </div>
            </div>

            <div class="form-row-2">
              <div class="field-grp">
                <label for="c_email">E-Mail-Adresse *</label>
                <input type="email" id="c_email" required placeholder="name@beispiel.de" class="cantina-input" />
              </div>
              <div class="field-grp">
                <label for="c_guests">Personenanzahl *</label>
                <select id="c_guests" class="cantina-input" required>
                  <option value="2">2 Personen</option>
                  <option value="3">3 Personen</option>
                  <option value="4" selected>4 Personen</option>
                  <option value="5">5 Personen</option>
                  <option value="6">6 Personen</option>
                  <option value="8+">8+ Personen (Gruppe)</option>
                </select>
              </div>
            </div>

            <div class="form-row-2">
              <div class="field-grp">
                <label for="c_date">Datum *</label>
                <input type="date" id="c_date" required class="cantina-input" />
              </div>
              <div class="field-grp">
                <label for="c_time">Uhrzeit *</label>
                <select id="c_time" class="cantina-input" required>
                  <option value="12:00">12:00 Uhr (Lunch)</option>
                  <option value="13:00">13:00 Uhr</option>
                  <option value="17:30">17:30 Uhr</option>
                  <option value="18:30" selected>18:30 Uhr</option>
                  <option value="19:30">19:30 Uhr</option>
                  <option value="20:30">20:30 Uhr</option>
                  <option value="21:30">21:30 Uhr</option>
                </select>
              </div>
            </div>

            <div class="field-grp">
              <label for="c_notes">Besondere Wünsche oder Anmerkungen (optional)</label>
              <textarea id="c_notes" rows="3" placeholder="z. B. Tisch am Fenster, Kinderstuhl benötigt..." class="cantina-input"></textarea>
            </div>

            <button type="submit" class="btn-primary form-submit-btn">
              <span>RESERVIERUNGSANFRAGE ABSENDEN</span>
              <span>🌮</span>
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  .kontakt-hero-section {
    background-color: var(--bg-canvas);
    padding: 5rem 0 6rem;
  }

  .kontakt-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: flex-start;
  }

  .kontakt-page-h1 {
    color: var(--brand-green);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin: 0.8rem 0 1.2rem;
  }

  .kontakt-lead {
    font-size: 1.15rem;
    color: var(--text-dark);
    line-height: 1.6;
    margin-bottom: 2.2rem;
  }

  .kontakt-direct-list {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .c-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border-bottom: var(--border-dashed);
    padding-bottom: 1.2rem;
  }

  .c-glyph {
    font-size: 1.6rem;
  }

  .c-item strong {
    display: block;
    color: var(--brand-green);
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .c-item p, .c-item a {
    font-size: 1rem;
    color: var(--text-ink);
  }

  .c-item a {
    color: var(--energy-red);
    font-weight: 700;
  }

  /* ── Form Column (NO CARDS) ── */
  .form-title {
    color: var(--brand-green);
    font-size: 2rem;
    margin-bottom: 1.8rem;
    border-bottom: 2px solid var(--brand-green);
    padding-bottom: 0.6rem;
  }

  .clean-cantina-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .field-grp {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-grp label {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--brand-green);
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .cantina-input {
    width: 100%;
    padding: 0.85rem 1.1rem;
    border-radius: 12px;
    border: var(--border-thick);
    background-color: var(--bg-canvas);
    color: var(--text-dark);
    font-family: var(--font-body);
    font-size: 1rem;
    outline: none;
    box-shadow: 0 2px 0 #075319;
    transition: border-color 0.18s, box-shadow 0.18s;
  }

  .cantina-input:focus {
    border-color: var(--energy-red);
    box-shadow: 0 4px 0 var(--energy-red);
  }

  .form-submit-btn {
    margin-top: 0.8rem;
    width: 100%;
  }

  @media (max-width: 950px) {
    .kontakt-hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 600px) {
    .form-row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contactPageForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('¡Muchas Gracias! Deine Reservierungsanfrage für Taco Loco Berlin-Mitte wurde erfolgreich empfangen. Wir senden dir in Kürze eine Bestätigung per E-Mail.');
      (form as HTMLFormElement).reset();
    });
  }
</script>
