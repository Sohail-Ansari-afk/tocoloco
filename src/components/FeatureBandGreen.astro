---
// FeatureBandGreen.astro — Deep Green #075319 Feature Section
// data-reveal / data-stagger — IntersectionObserver animates in via animations.js
---

<section class="feature-band-green" id="story-highlight">
  <div class="cantina-container">
    <div class="green-band-grid">
      
      <!-- Left Content Column -->
      <div class="band-content">
        <span class="sticker-badge badge-new" style="transform:rotate(-2deg)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          DEINE CANTINA IN BERLIN
        </span>
        <h2 class="band-title feature-band-headline" data-reveal>
          <span>BIG FLAVOR.</span>
          <span class="title-highlight">ZERO BORING.</span>
        </h2>
        
        <p class="band-lead">
          Du suchst ein <strong>mexikanisches Restaurant in Berlin-Mitte</strong>? Bei Taco Loco erwartet dich echte Cantina-Atmosphäre, traditionelle Rezepte und frische Zutaten.
        </p>

        <ul class="band-features-list" data-stagger>
          <li class="feature-item">
            <span class="check-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span><strong>Täglich frisch zubereitet:</strong> Handgemachte Guacamole, Salsas und marinierte Fleisch- &amp; Veggie-Spezialitäten.</span>
          </li>
          <li class="feature-item">
            <span class="check-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span><strong>Für alle Ernährungsweisen:</strong> Große Auswahl an vegetarischen &amp; veganen Varianten.</span>
          </li>
          <li class="feature-item">
            <span class="check-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span><strong>Zentrale Lage:</strong> Reinhardtstraße 37, Berlin-Mitte — nahe Friedrichstraße &amp; Hauptbahnhof.</span>
          </li>
        </ul>

        <div class="band-cta-row">
          <a href="/speisekarte" class="btn-yellow">
            <span>SPEISEKARTE ENTDECKEN</span>
            <span>→</span>
          </a>
          <a 
            href="https://www.google.com/maps/reserve/v/dine/c/0hxd20-gUKU?source=pa&opi=79508299&hl=en-IN&gei=EL6PauOABevQwcsP1JSfoAE&ahbb=1&sourceurl=https://www.google.com/maps/preview/place?authuser%3D0%26hl%3Den%26gl%3Din%26pb%3D!1m14!1s0x47a851dbd1c782e9:0xe4e5b3aac100aaca!3m12!1m3!1d50109.128351697895!2d73.89408309999999!3d18.847821250000003!2m3!1f0!2f0!3f0!3m2!1i2552!2i1274!4f13.1!12m4!2m3!1i360!2i120!4i8!13m57!2m2!1i203!2i100!3m2!2i4!5b1!6m6!1m2!1i86!2i86!1m2!1i408!2i240!7m33!1m3!1e1!2b0!3e3!1m3!1e2!2b1!3e2!1m3!1e2!2b0!3e3!1m3!1e8!2b0!3e3!1m3!1e10!2b0!3e3!1m3!1e10!2b1!3e2!1m3!1e10!2b0!3e4!1m3!1e9!2b1!3e2!2b1!9b0!15m8!1m7!1m2!1m1!1e2!2m2!1i195!2i195!3i20!14m5!1sA76Pasy_JcyywcsP89HToAc:53!2s1i:0,t:150714,p:A76Pasy_JcyywcsP89HToAc:53!7e81!12e3!17sA76Pasy_JcyywcsP89HToAc:60!15m110!1m28!13m9!2b1!3b1!4b1!6i1!8b1!9b1!14b1!20b1!25b1!18m17!3b1!4b1!5b1!6b1!9b1!13b1!14b1!17b1!20b1!21b1!22b1!30b1!32b1!33m1!1b1!34b1!36e2!10m1!8e3!11m1!3e1!17b1!20m2!1e3!1e6!24b1!25b1!26b1!27b1!29b1!30m1!2b1!36b1!37b1!39m3!2m2!2i1!3i1!43b1!52b1!54m1!1b1!55b1!56m1!1b1!61m2!1m1!1e1!65m5!3m4!1m3!1m2!1i224!2i298!72m22!1m8!2b1!5b1!7b1!12m4!1b1!2b1!4m1!1e1!4b1!8m10!1m6!4m1!1e1!4m1!1e3!4m1!1e4!3sother_user_google_review_posts__and__hotel_and_vr_partner_review_posts!6m1!1e1!9b1!89b1!90m2!1m1!1e2!98m3!1b1!2b1!3b1!103b1!113b1!114m3!1b1!2m1!1b1!117b1!122m1!1b1!126b1!127b1!128m1!1b1!21m28!1m6!1m2!i0!2i0!2m2!1i530!2i1274!1m6!1m2!i2502!2i0!2m2!1i2552!2i1274!1m6!1m2!i0!2i0!2m2!1i2552!2i20!1m6!1m2!i0!2i1254!2m2!1i2552!2i1274!22m1!1e81!29m0!30m6!3b1!6m1!2b1!7m1!2b1!9b1!34m5!7b1!10b1!14b1!15m1!1b0!37i792!39sTaco%2BLoco%2BCantina%2BMexicana,%2BReinhardtstra%25C3%259Fe,%2BBerlin,%2BGermany%26q%3DTaco%2BLoco%2BCantina%2BMexicana,%2BReinhardtstra%25C3%259Fe,%2BBerlin,%2BGermany" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-secondary band-secondary-btn"
            aria-label="Tisch reservieren via Google Maps"
          >
            <span>TISCH RESERVIEREN</span>
          </a>
        </div>
      </div>

      <!-- Right Graphic / Food Spread Column -->
      <div class="band-visual" data-reveal>
        <div class="visual-badge-wrap">
          <span class="sticker-badge badge-spicy" style="transform:rotate(3deg)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8 2 5 6 5 10c0 4 3 7 7 9 4-2 7-5 7-9 0-4-3-8-7-8z"/></svg>
            100% MEXIKANISCHER GESCHMACK
          </span>
        </div>

        <div class="food-composition">
          <img 
            src="/images/Tacos.webp" 
            alt="Frische Tacos bei Taco Loco Berlin-Mitte" 
            class="band-food-main animate-bounce-subtle"
            width="380"
            height="300"
            loading="lazy"
          />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .feature-band-green {
    background-color: var(--brand-green);
    color: var(--bg-canvas);
    padding: 5rem 0;
    position: relative;
    overflow: hidden;
    border-bottom: 3px solid var(--accent-yellow);
  }

  .green-band-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    gap: 3.5rem;
  }

  .band-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .band-title {
    color: var(--bg-canvas);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1;
    margin: 1rem 0 1.2rem;
    display: flex;
    flex-direction: column;
  }

  .title-highlight {
    color: var(--accent-yellow);
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.35);
  }

  .band-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--bg-canvas);
    margin-bottom: 1.8rem;
  }

  .band-features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.2rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1.02rem;
    line-height: 1.5;
    color: #FFF8DE;
  }

  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background-color: var(--accent-yellow);
    color: var(--brand-green);
    font-weight: 900;
    font-size: 0.9rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .band-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
  }

  .band-secondary-btn {
    color: var(--bg-canvas) !important;
    border-color: var(--bg-canvas) !important;
  }

  .band-secondary-btn:hover {
    background-color: var(--accent-yellow) !important;
    color: var(--brand-green) !important;
    border-color: var(--accent-yellow) !important;
  }

  /* ── Right Visual Composition ── */
  .band-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .visual-badge-wrap {
    margin-bottom: 1.5rem;
  }

  .food-composition {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 380px;
  }

  .band-food-main {
    width: 100%;
    max-width: 580px;
    max-height: 480px;
    height: auto;
    object-fit: contain;
    transform: scale(1.25);
    filter: drop-shadow(0 28px 50px rgba(0, 0, 0, 0.6));
    transition: transform var(--dur-medium) var(--ease-out);
    position: relative;
    z-index: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .band-food-main:hover {
      transform: scale(1.36) rotate(1.5deg);
    }
  }

  /* ── Responsive ── */
  @media (max-width: 950px) {
    .green-band-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .band-content {
      align-items: center;
      text-align: center;
    }
    .band-features-list {
      text-align: left;
    }
    .band-cta-row {
      justify-content: center;
    }
    .band-food-main {
      transform: scale(1.1);
      max-height: 320px;
    }
  }

  @media (max-width: 600px) {
    .feature-band-green {
      padding: 3.5rem 0;
    }
    .food-composition {
      min-height: 240px;
    }
    .band-food-main {
      transform: scale(1.05);
      max-height: 250px;
    }
  }
</style>
