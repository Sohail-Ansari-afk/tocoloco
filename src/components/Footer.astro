<style>
  .cantina-footer {
    background-color: var(--brand-green);
    color: var(--bg-canvas);
    position: relative;
    padding: 4rem 0 2rem;
    border-top: 4px solid var(--accent-yellow);
    overflow-x: hidden;
  }

  /* ── Footer Grid ── */
  .footer-main-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 2.8rem;
    margin-bottom: 3rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-logo {
    height: 65px;
    width: auto;
    object-fit: contain;
    margin-bottom: 1.2rem;
  }

  .footer-brand-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #FFF8DE;
    margin-bottom: 1.4rem;
  }

  .social-links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .social-link {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--brand-green);
    background-color: var(--accent-yellow);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid #043610;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .social-link:hover {
    transform: translateY(-2px);
    background-color: #ffd866;
  }

  .footer-col-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--accent-yellow);
    margin-bottom: 1.2rem;
    letter-spacing: 0.5px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a {
    font-size: 0.92rem;
    color: #FFF8DE;
    transition: color 0.18s ease, transform 0.18s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--accent-yellow);
    transform: translateX(3px);
  }

  .footer-address, .footer-times {
    font-size: 0.92rem;
    line-height: 1.5;
    color: #FFF8DE;
    margin-bottom: 0.8rem;
  }

  .footer-reserve-btn {
    display: inline-block;
    text-decoration: none;
    margin-top: 0.6rem;
    background-color: var(--accent-yellow);
    color: var(--brand-green);
    font-family: var(--font-body);
    font-weight: 900;
    font-size: 0.95rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-pill);
    border: var(--border-thick);
    box-shadow: 0 4px 0 #043610;
    transition: transform 0.18s ease, background-color 0.18s ease;
  }

  .footer-reserve-btn:hover {
    transform: translateY(-2px);
    background-color: #ffd866;
  }

  /* ── GEO Block ── */
  .footer-geo-block {
    background-color: rgba(0, 0, 0, 0.22);
    border-radius: 12px;
    padding: 1.2rem 1.5rem;
    margin-bottom: 2rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #FFF8DE;
    border: 1px solid rgba(247, 200, 68, 0.25);
  }

  /* ── Bottom Row ── */
  .footer-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 241, 199, 0.2);
    padding-top: 1.4rem;
    font-size: 0.88rem;
    color: #FFF8DE;
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .legal-links a {
    color: var(--accent-yellow);
    text-decoration: underline;
  }

  /* ── Responsive ── */
  @media (max-width: 1050px) {
    .footer-main-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .cantina-footer {
      padding: 3.5rem 0 2rem;
    }
    .footer-main-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-bottom-row {
      flex-direction: column;
      gap: 0.8rem;
      text-align: center;
    }
  }
</style>
