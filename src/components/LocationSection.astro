---
// LocationSection.astro — Zero-Cards Location & Google Map Spread (Berlin-Mitte)
---

<section class="location-section" id="anfahrt">
  <div class="cantina-container">
    
    <!-- Header -->
    <div class="section-header-center">
      <span class="sticker-badge badge-new">📍 ZENTRAL IN BERLIN-MITTE</span>
      <h2 class="section-title">BESUCHE UNSERE CANTINA</h2>
      <p class="section-lead">
        Taco Loco liegt zentral an der <strong>Reinhardtstraße 37, 10117 Berlin</strong> — nur wenige Gehminuten vom Bahnhof Friedrichstraße, dem Hauptbahnhof, der Charité und dem Deutschen Theater entfernt.
      </p>
    </div>

    <!-- Open 2-Column Grid (NO BOX CARDS) -->
    <div class="location-open-grid">
      
      <!-- Info Column -->
      <div class="location-details-col">
        <div class="info-group">
          <div class="info-heading-row">
            <span class="info-glyph">🌮</span>
            <h3>ADRESSE & KONTAKT</h3>
          </div>
          <address class="address-text">
            <strong>Taco Loco Cantina Mexicana</strong><br />
            Reinhardtstraße 37<br />
            10117 Berlin-Mitte, Deutschland
          </address>
          <div class="direct-contact-links">
            <a href="tel:+493094054782" class="contact-link" aria-label="Telefonnummer anrufen: +49 30 94054782">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.12 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>+49 30 94054782</span>
            </a>
            <a href="mailto:info@taco-loco-berlin.de" class="contact-link" aria-label="E-Mail senden: info@taco-loco-berlin.de">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span>info@taco-loco-berlin.de</span>
            </a>
          </div>
        </div>

        <div class="info-group hours-group">
          <div class="info-heading-row">
            <span class="info-glyph">⏰</span>
            <h3>ÖFFNUNGSZEITEN</h3>
          </div>
          <ul class="hours-list">
            <li>
              <span>Montag – Donnerstag:</span>
              <strong>12:00 – 23:00 Uhr</strong>
            </li>
            <li>
              <span>Freitag – Samstag:</span>
              <strong>12:00 – 00:00 Uhr</strong>
            </li>
            <li>
              <span>Sonntag & Feiertage:</span>
              <strong>12:00 – 23:00 Uhr</strong>
            </li>
          </ul>
        </div>

        <div class="location-action-row">
          <a 
            href="https://maps.app.goo.gl/L1YRicrkoW9naqQZ8" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-primary"
            aria-label="Route in Google Maps öffnen"
          >
            <span>ROUTE IN GOOGLE MAPS →</span>
          </a>
          <a 
            href="https://www.google.com/maps/reserve/v/dine/c/0hxd20-gUKU?source=pa&opi=79508299&hl=en-IN&gei=EL6PauOABevQwcsP1JSfoAE&ahbb=1&sourceurl=https://www.google.com/maps/preview/place?authuser%3D0%26hl%3Den%26gl%3Din%26pb%3D!1m14!1s0x47a851dbd1c782e9:0xe4e5b3aac100aaca!3m12!1m3!1d50109.128351697895!2d73.89408309999999!3d18.847821250000003!2m3!1f0!2f0!3f0!3m2!1i2552!2i1274!4f13.1!12m4!2m3!1i360!2i120!4i8!13m57!2m2!1i203!2i100!3m2!2i4!5b1!6m6!1m2!1i86!2i86!1m2!1i408!2i240!7m33!1m3!1e1!2b0!3e3!1m3!1e2!2b1!3e2!1m3!1e2!2b0!3e3!1m3!1e8!2b0!3e3!1m3!1e10!2b0!3e3!1m3!1e10!2b1!3e2!1m3!1e10!2b0!3e4!1m3!1e9!2b1!3e2!2b1!9b0!15m8!1m7!1m2!1m1!1e2!2m2!1i195!2i195!3i20!14m5!1sA76Pasy_JcyywcsP89HToAc:53!2s1i:0,t:150714,p:A76Pasy_JcyywcsP89HToAc:53!7e81!12e3!17sA76Pasy_JcyywcsP89HToAc:60!15m110!1m28!13m9!2b1!3b1!4b1!6i1!8b1!9b1!14b1!20b1!25b1!18m17!3b1!4b1!5b1!6b1!9b1!13b1!14b1!17b1!20b1!21b1!22b1!30b1!32b1!33m1!1b1!34b1!36e2!10m1!8e3!11m1!3e1!17b1!20m2!1e3!1e6!24b1!25b1!26b1!27b1!29b1!30m1!2b1!36b1!37b1!39m3!2m2!2i1!3i1!43b1!52b1!54m1!1b1!55b1!56m1!1b1!61m2!1m1!1e1!65m5!3m4!1m3!1m2!1i224!2i298!72m22!1m8!2b1!5b1!7b1!12m4!1b1!2b1!4m1!1e1!4b1!8m10!1m6!4m1!1e1!4m1!1e3!4m1!1e4!3sother_user_google_review_posts__and__hotel_and_vr_partner_review_posts!6m1!1e1!9b1!89b1!90m2!1m1!1e2!98m3!1b1!2b1!3b1!103b1!113b1!114m3!1b1!2m1!1b1!117b1!122m1!1b1!126b1!127b1!128m1!1b1!21m28!1m6!1m2!i0!2i0!2m2!1i530!2i1274!1m6!1m2!i2502!2i0!2m2!1i2552!2i1274!1m6!1m2!i0!2i0!2m2!1i2552!2i20!1m6!1m2!i0!2i1254!2m2!1i2552!2i1274!22m1!1e81!29m0!30m6!3b1!6m1!2b1!7m1!2b1!9b1!34m5!7b1!10b1!14b1!15m1!1b0!37i792!39sTaco%2BLoco%2BCantina%2BMexicana,%2BReinhardtstra%25C3%259Fe,%2BBerlin,%2BGermany%26q%3DTaco%2BLoco%2BCantina%2BMexicana,%2BReinhardtstra%25C3%259Fe,%2BBerlin,%2BGermany" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-secondary"
            aria-label="Tisch reservieren via Google Maps"
          >
            <span>TISCH RESERVIEREN</span>
          </a>
        </div>
      </div>

      <!-- Map & Transit Column -->
      <div class="location-map-col">
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2427.702955519827!2d13.3776432!3d52.5225743!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a851dbd1c782e9%3A0xe4e5b3aac100aaca!2sTaco%20Loco%20Cantina%20Mexicana!5e0!3m2!1sde!2sde!4v1710000000000!5m2!1sde!2sde"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Taco Loco Cantina Mexicana Berlin-Mitte Google Map">
          </iframe>
        </div>

        <div class="transit-badges-row">
          <span class="transit-badge">🚆 S+U Friedrichstraße (6 Min.)</span>
          <span class="transit-badge">🚄 Berlin Hauptbahnhof (9 Min.)</span>
          <span class="transit-badge">🚇 U Oranienburger Tor (5 Min.)</span>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .location-section {
    background-color: var(--bg-canvas);
    padding: 5.5rem 0 6.5rem;
    border-bottom: 3px solid var(--brand-green);
  }

  .section-header-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    color: var(--brand-green);
    margin: 0.6rem 0 0.8rem;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  }

  .section-lead {
    color: var(--text-dark);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  /* ── Open 2-Column Grid (NO CARDS) ── */
  .location-open-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    align-items: center;
  }

  .location-details-col {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }

  .info-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .info-heading-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .info-glyph {
    font-size: 1.3rem;
  }

  .info-heading-row h3 {
    font-size: 1.3rem;
    color: var(--brand-green);
  }

  .address-text {
    font-style: normal;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--text-ink);
  }

  .direct-contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    color: var(--energy-red);
    font-size: 1.05rem;
    transition: color 0.18s, transform 0.18s;
    text-decoration: none;
    width: fit-content;
  }

  .contact-link:hover {
    color: var(--brand-green);
    transform: translateX(4px);
  }

  .hours-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hours-list li {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    color: var(--text-dark);
    border-bottom: var(--border-dashed);
    padding-bottom: 0.4rem;
  }

  .hours-list li strong {
    color: var(--brand-green);
  }

  .location-action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  /* ── Map Frame ── */
  .location-map-col {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .map-frame {
    width: 100%;
    height: 400px;
    border-radius: var(--radius-frame);
    border: var(--border-ultra);
    overflow: hidden;
    box-shadow: 0 12px 28px rgba(7, 83, 25, 0.2);
  }

  .transit-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .transit-badge {
    padding: 0.55rem 1rem;
    background-color: var(--bg-canvas);
    border-radius: var(--radius-pill);
    border: var(--border-thick);
    box-shadow: 0 2px 0 #075319;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--brand-green);
  }

  @media (max-width: 950px) {
    .location-open-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .location-section {
      padding: 3.5rem 0;
    }
    .map-frame {
      height: 280px;
    }
  }
</style>
