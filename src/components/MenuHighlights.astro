---
// MenuHighlights.astro — Zero-Cards Editorial Menu Spreads (Open Typographic Layout)
const menuItems = [
  {
    id: 'taco-loco',
    name: 'Taco Loco (Haus-Spezialität)',
    category: 'tacos',
    badge: '★ SIGNATURE',
    badgeType: 'badge-favorite',
    spiceLevel: 1,
    desc: 'Gebratenes Gemüse (Zucchini, Aubergine, Tomaten, Paprika, Zwiebeln, Champignons) in Kräuter-Tomatensauce, mit Käse überbacken, dazu Maistortillas, Guacamole, Sauerrahm & Salsa Picante.',
    price: '12,50 €',
    dietary: 'Vegetarisch / Vegan mögl.',
    image: '/images/Tacos.webp'
  },
  {
    id: 'tacos-al-pastor',
    name: 'Tacos al Pastor',
    category: 'tacos',
    badge: '🌶️ HOT PICANTE',
    badgeType: 'badge-spicy',
    spiceLevel: 2,
    desc: 'Zarte Rinderhüftsteakstreifen mit Paprika, Zwiebeln, Bohnen, Fetakäse und hausgemachter Salsa Verde, serviert mit mexikanischem Reis und Salat.',
    price: '15,90 €',
    dietary: 'Rindfleisch',
    image: '/images/Tacos.webp'
  },
  {
    id: 'tacos-de-pollo',
    name: 'Tacos de Pollo',
    category: 'tacos',
    badge: '🔥 BELIEBT',
    badgeType: 'badge-new',
    spiceLevel: 1,
    desc: 'Gebratene Hähnchenbruststreifen mit Zwiebeln in exotischer Sauce, mit Käse überbacken und Weizenmehltortillas, Guacamole, Salsa & Sauerrahm.',
    price: '13,90 €',
    dietary: 'Geflügel',
    image: '/images/Tacos.webp'
  },
  {
    id: 'burrito-picadillo',
    name: 'Burrito Picadillo',
    category: 'burritos',
    badge: '★ BESTSELLER',
    badgeType: 'badge-favorite',
    spiceLevel: 2,
    desc: 'Herzhaft gefüllt mit gewürztem Rinderhackfleisch, Bohnen, mexikanischem Reis und Käse, dazu Sauerrahm und Pico de Gallo.',
    price: '14,50 €',
    dietary: 'Rindfleisch',
    image: '/images/Burritos.webp'
  },
  {
    id: 'burrito-vegetariano',
    name: 'Burrito Vegetariano',
    category: 'burritos',
    badge: '🌱 VEGAN / VEG',
    badgeType: 'badge-vegan',
    spiceLevel: 1,
    desc: 'Bunte Gemüsemischung aus Zucchini, Paprika, Mais und schwarzen Bohnen in Weizentortilla gerollt, serviert mit Guacamole & Salsa.',
    price: '12,90 €',
    dietary: 'Pflanzlich',
    image: '/images/Burritos.webp'
  },
  {
    id: 'quesadilla-mixtos',
    name: 'Quesadilla Mixtos',
    category: 'quesadillas',
    badge: '🧀 KNUSPRIG',
    badgeType: 'badge-new',
    spiceLevel: 1,
    desc: 'Große gegrillte Weizentortilla mit Hähnchenfleisch, Hackfleisch und viel schmelzendem Käse, serviert mit Salsa & Sauerrahm.',
    price: '14,90 €',
    dietary: 'Geflügel & Rind',
    image: '/images/Quesadillas.webp'
  },
  {
    id: 'enchilada-pollo',
    name: 'Enchilada Pollo',
    category: 'enchiladas',
    badge: '🌶️ ÜBERBACKEN',
    badgeType: 'badge-spicy',
    spiceLevel: 2,
    desc: 'Zwei gerollte Tortillas gefüllt mit Hähnchen, bedeckt mit würziger Tomaten-Chili-Sauce und einer goldgelben Käsekruste.',
    price: '14,50 €',
    dietary: 'Geflügel',
    image: '/images/Enchiladas.webp'
  },
  {
    id: 'fajita-carne',
    name: 'Fajita Carne (Pfannengericht)',
    category: 'fajitas',
    badge: '🔥 SIZZLING',
    badgeType: 'badge-spicy',
    spiceLevel: 2,
    desc: 'Gegrillte argentinische Rinderhüftstreifen mit Zwiebeln und Paprika in der heißen Pfanne serviert, dazu 3 Tortillas & Dips.',
    price: '18,90 €',
    dietary: 'Rindfleisch',
    image: '/images/Tacos.webp'
  }
];
---

<section class="menu-highlights-section" id="speisekarte-highlights">
  <div class="cantina-container">
    
    <!-- Section Header -->
    <div class="section-header-center">
      <span class="sticker-badge badge-spicy">🌶️ FRISCH & FEURIG</span>
      <h2 class="section-title">SPEISEN & EMPFEHLUNGEN</h2>
      <p class="section-lead">
        Authentische Rezepte, saftige Füllungen und frische Salsas. Wähle deine Kategorie und entdecke deinen nächsten Favoriten bei Taco Loco.
      </p>

      <!-- Category Filter Tabs (Pill Buttons) -->
      <div class="menu-filter-bar">
        <button class="filter-btn active" data-filter="all">ALLE GERICHTE</button>
        <button class="filter-btn" data-filter="tacos">🌮 TACOS</button>
        <button class="filter-btn" data-filter="burritos">🌯 BURRITOS</button>
        <button class="filter-btn" data-filter="quesadillas">🧀 QUESADILLAS</button>
        <button class="filter-btn" data-filter="enchiladas">🌶️ ENCHILADAS</button>
        <button class="filter-btn" data-filter="fajitas">🥘 FAJITAS</button>
      </div>
    </div>

    <!-- Editorial Spreads Grid (NO CARDS - Pure Editorial Rows) -->
    <div class="menu-editorial-list" id="menuEditorialList">
      {menuItems.map((item) => (
        <article class="editorial-dish-row" data-category={item.category}>
          
          <!-- Cutout Food Image -->
          <div class="dish-cutout-col">
            <img 
              src={item.image} 
              alt={item.name} 
              class="dish-cutout-img"
              width="200"
              height="160"
              loading="lazy"
            />
          </div>

          <!-- Dish Info -->
          <div class="dish-details-col">
            <div class="dish-head-row">
              <div class="dish-title-group">
                <h3 class="dish-name-title">{item.name}</h3>
                <span class:list={['sticker-badge', item.badgeType]}>{item.badge}</span>
              </div>
              
              <div class="dish-price-group">
                <div class="spice-icons" title={`Schärfe: ${item.spiceLevel} von 3`}>
                  {Array.from({ length: item.spiceLevel }).map(() => (
                    <span>🌶️</span>
                  ))}
                </div>
                <span class="dish-price-tag">{item.price}</span>
              </div>
            </div>

            <p class="dish-desc-text">{item.desc}</p>
            
            <div class="dish-meta-row">
              <a 
                href="https://www.google.com/maps/reserve/v/dine/c/0hxd20-gUKU?source=pa&opi=79508299&hl=en-IN&gei=EL6PauOABevQwcsP1JSfoAE&ahbb=1&sourceurl=https://www.google.com/maps/preview/place?authuser%3D0%26hl%3Den%26gl%3Din%26pb%3D!1m14!1s0x47a851dbd1c782e9:0xe4e5b3aac100aaca!3m12!1m3!1d50109.128351697895!2d73.89408309999999!3d18.847821250000003!2m3!1f0!2f0!3f0!3m2!1i2552!2i1274!4f13.1!12m4!2m3!1i360!2i120!4i8!13m57!2m2!1i203!2i100!3m2!2i4!5b1!6m6!1m2!1i86!2i86!1m2!1i408!2i240!7m33!1m3!1e1!2b0!3e3!1m3!1e2!2b1!3e2!1m3!1e2!2b0!3e3!1m3!1e8!2b0!3e3!1m3!1e10!2b0!3e3!1m3!1e10!2b1!3e2!1m3!1e10!2b0!3e4!1m3!1e9!2b1!3e2!2b1!9b0!15m8!1m7!1m2!1m1!1e2!2m2!1i195!2i195!3i20!14m5!1sA76Pasy_JcyywcsP89HToAc:53!2s1i:0,t:150714,p:A76Pasy_JcyywcsP89HToAc:53!7e81!12e3!17sA76Pasy_JcyywcsP89HToAc:60!15m110!1m28!13m9!2b1!3b1!4b1!6i1!8b1!9b1!14b1!20b1!25b1!18m17!3b1!4b1!5b1!6b1!9b1!13b1!14b1!17b1!20b1!21b1!22b1!30b1!32b1!33m1!1b1!34b1!36e2!10m1!8e3!11m1!3e1!17b1!20m2!1e3!1e6!24b1!25b1!26b1!27b1!29b1!30m1!2b1!36b1!37b1!39m3!2m2!2i1!3i1!43b1!52b1!54m1!1b1!55b1!56m1!1b1!61m2!1m1!1e1!65m5!3m4!1m3!1m2!1i224!2i298!72m22!1m8!2b1!5b1!7b1!12m4!1b1!2b1!4m1!1e1!4b1!8m10!1m6!4m1!1e1!4m1!1e3!4m1!1e4!3sother_user_google_review_posts__and__hotel_and_vr_partner_review_posts!6m1!1e1!9b1!89b1!90m2!1m1!1e2!98m3!1b1!2b1!3b1!103b1!113b1!114m3!1b1!2m1!1b1!117b1!122m1!1b1!126b1!127b1!128m1!1b1!21m28!1m6!1m2!i0!2i0!2m2!1i530!2i1274!1m6!1m2!i2502!2i0!2m2!1i2552!2i1274!1m6!1m2!i0!2i0!2m2!1i2552!2i20!1m6!1m2!i0!2i1254!2m2!1i2552!2i1274!22m1!1e81!29m0!30m6!3b1!6m1!2b1!7m1!2b1!9b1!34m5!7b1!10b1!14b1!15m1!1b0!37i792!39sTaco%2BLoco%2BCantina%2BMexicana,%2BReinhardtstra%25C3%259Fe,%2BBerlin,%2BGermany%26q%3DTaco%2BLoco%2BCantina%2BMexicana,%2BReinhardtstra%25C3%259Fe,%2BBerlin,%2BGermany" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="dish-reserve-action"
                aria-label="Tisch reservieren via Google Maps"
              >
                <span>TISCH RESERVIEREN →</span>
              </a>
            </div>
          </div>

        </article>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="menu-bottom-row">
      <a href="/speisekarte" class="btn-primary">
        <span>GESAMTE SPEISEKARTE ANSEHEN →</span>
      </a>
    </div>

  </div>
</section>

<style>
  .menu-highlights-section {
    background-color: var(--bg-canvas);
    padding: 5rem 0 5.5rem;
    border-bottom: 3px solid var(--brand-green);
  }

  .section-header-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    color: var(--brand-green);
    margin: 0.6rem 0 0.8rem;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  }

  .section-lead {
    color: var(--text-dark);
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 2.2rem;
  }

  /* ── Filter Bar ── */
  .menu-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .filter-btn {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.92rem;
    letter-spacing: 0.4px;
    color: var(--brand-green);
    background-color: transparent;
    border: var(--border-thick);
    padding: 0.6rem 1.4rem;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sticker);
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .filter-btn:hover {
    transform: translateY(-2px);
    background-color: var(--accent-yellow);
  }

  .filter-btn.active {
    background-color: var(--brand-green);
    color: var(--accent-yellow);
    box-shadow: 0 4px 0 #043610;
  }

  /* ── Editorial Spreads List (NO CARDS) ── */
  .menu-editorial-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2.5rem;
    margin-bottom: 3.5rem;
  }

  .editorial-dish-row {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding-bottom: 1.8rem;
    border-bottom: var(--border-dashed);
    transition: transform 0.25s ease;
  }

  .editorial-dish-row:hover {
    transform: translateX(4px);
  }

  .dish-cutout-col {
    width: 140px;
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dish-cutout-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: var(--drop-shadow-food);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .editorial-dish-row:hover .dish-cutout-img {
    transform: scale(1.12) rotate(2deg);
  }

  .dish-details-col {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .dish-head-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .dish-title-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }

  .dish-name-title {
    color: var(--brand-green);
    font-size: 1.25rem;
    line-height: 1.15;
  }

  .dish-price-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
  }

  .spice-icons {
    font-size: 0.85rem;
  }

  .dish-price-tag {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.25rem;
    color: var(--energy-red);
    white-space: nowrap;
  }

  .dish-desc-text {
    font-size: 0.9rem;
    color: var(--text-ink);
    line-height: 1.45;
    margin-bottom: 0.8rem;
  }

  .dish-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dish-dietary-badge {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .dish-reserve-action {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.82rem;
    color: var(--brand-green);
    text-transform: uppercase;
    letter-spacing: 0.3px;
    transition: color 0.15s, transform 0.15s;
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }

  .dish-reserve-action:hover {
    color: var(--energy-red);
    transform: translateX(3px);
  }

  .menu-bottom-row {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1000px) {
    .menu-editorial-list {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 550px) {
    .editorial-dish-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .dish-cutout-col {
      width: 100%;
      height: 120px;
      justify-content: flex-start;
    }
  }
</style>

<script>
  // Filter logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.editorial-dish-row');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      items.forEach((item) => {
        const category = item.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          (item as HTMLElement).style.display = 'flex';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
