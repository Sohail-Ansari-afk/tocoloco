# Cloudflare Pages Custom Headers Configuration

# Immutable cache for static Vite / Astro bundled assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# High-performance 1-year cache for static media and images
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/logo.png
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=604800

# Security and performance headers for all HTML pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
